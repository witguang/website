---
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  post: Post;
  showDescription?: boolean;
}

const { post, showDescription = true } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<a class="post-row" href={`/blog/${post.id}/`}>
  <time class="post-date" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>

  <span class="post-body">
    <span class="post-title">
      {title}{draft && <span class="draft-badge">草稿</span>}
    </span>
    {showDescription && <span class="post-desc">{description}</span>}
  </span>

  <span class="post-tags">
    {tags.slice(0, 2).map((tag) => <span class="chip">{tag}</span>)}
  </span>
</a>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.35rem 1.25rem;
    padding: 1.05rem 0.5rem 1.05rem 0;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.15s ease, padding-left 0.15s ease;
  }

  .post-row::before {
    content: '';
    position: absolute;
    left: -0.65rem;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .post-row:hover {
    background: color-mix(in srgb, var(--surface-soft) 60%, transparent);
  }

  .post-row:hover::before {
    opacity: 1;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--text-mute);
    font-variant-numeric: tabular-nums;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.8375rem;
    line-height: 1.6;
    color: var(--text-mute);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .post-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .draft-badge {
    margin-left: 0.5rem;
    padding: 0.05rem 0.35rem;
    border: 1px dashed var(--line-strong);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    color: var(--text-mute);
    vertical-align: 0.1em;
  }

  @media (max-width: 40rem) {
    .post-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.3rem;
      padding-right: 0;
    }

    .post-tags {
      justify-content: flex-start;
    }

    .post-date {
      order: -1;
    }
  }
</style>
