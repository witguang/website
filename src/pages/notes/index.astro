---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allNotes, kindClass } from '../../lib/notes';
import { formatDate, formatDateCN } from '../../lib/posts';
import { tagSlug } from '../../lib/tags';

const notes = await allNotes();
const rendered = await Promise.all(
  notes.map(async (note) => ({ note, ...(await render(note)) })),
);
---

<BaseLayout title="想法" description="一句话、一段话，或者一个小故事。">
  <div class="wrap page-head">
    <p class="eyebrow">Notes</p>
    <h1 class="page-title">想法</h1>
    <p class="page-sub">
      共 {notes.length} 条 · 一句话、一段话，或者一个比喻。按时间倒序。
    </p>
  </div>

  <div class="wrap note-list-wrap">
    <ol class="note-list">
      {
        rendered.map(({ note, Content }) => (
          <li class="note" id={note.id}>
            <div class="note-gutter">
              <time datetime={note.data.date.toISOString()} title={formatDateCN(note.data.date)}>
                {formatDate(note.data.date)}
              </time>
              <span class={`kind kind--${kindClass[note.data.kind] ?? 'para'}`}>
                {note.data.kind}
              </span>
            </div>

            <div class="note-content">
              {note.data.title && <h2 class="note-title">{note.data.title}</h2>}
              <div class="prose note-body">
                <Content />
              </div>
              <div class="note-foot">
                {note.data.tags.map((tag) => (
                  <a class="chip" href={`/tags/${tagSlug(tag)}/`}>
                    {tag}
                  </a>
                ))}
                <a class="permalink" href={`#${note.id}`} aria-label="这条想法的固定链接">
                  #
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .page-title {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.03em;
  }

  .page-sub {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-mute);
  }

  .note-list-wrap {
    max-width: calc(var(--measure) + 9rem);
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 5.5rem;
  }

  /* 锚点被访问时给个轻微高亮，方便从别处跳进来 */
  .note:target .note-gutter {
    color: var(--accent);
  }

  .note-gutter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-mute);
    transition: color 0.2s ease;
  }

  .note-gutter time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .kind {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .kind--line {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    color: var(--accent);
  }

  .kind--story {
    border-color: var(--line-strong);
    color: var(--text-soft);
  }

  .note-content {
    min-width: 0;
  }

  .note-title {
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note-body {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-soft);
  }

  .note-body p {
    margin: 0;
  }

  .note-body p + p {
    margin-top: 0.9em;
  }

  .note-foot {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .permalink {
    margin-left: auto;
    padding: 0 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-mute);
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .note:hover .permalink,
  .permalink:focus-visible {
    opacity: 1;
  }

  .permalink:hover {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .note {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
      padding-block: 1.5rem;
    }

    .note-gutter {
      flex-direction: row;
      align-items: center;
      gap: 0.6rem;
    }

    .permalink {
      opacity: 1;
    }
  }
</style>
